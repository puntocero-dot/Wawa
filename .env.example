# Supabase — create a project at https://supabase.com and copy these from
# Project Settings → API. NEXT_PUBLIC_* values are safe to expose to the
# browser; never expose the service role key this way.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used only in server-side code (migrations, admin scripts) — never imported
# by client components.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini key for the AI flows in src/ai (semantic wisdom search,
# tag suggestions, audio transcription).
GOOGLE_GENERATIVE_AI_API_KEY=
